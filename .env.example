# Application
APP_NAME=BharatResilience AI
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=True

# Database
DATABASE_URL=postgresql://bharatresilience:resilience123@localhost:5432/bharat_resilience
SQLALCHEMY_ECHO=True

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
CACHE_TTL=300

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External APIs
WEATHER_API_KEY=
WEATHER_API_PROVIDER=open-meteo
EARTHQUAKE_API_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
FLOOD_API_URL=https://api.flooddata.com/v1
WATER_API_URL=

# Alerts
ALERT_THRESHOLD=70
EMAIL_FROM=alerts@bharatresilience.ai
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Geospatial
DEFAULT_LATITUDE=20.5937
DEFAULT_LONGITUDE=78.9629
DEFAULT_COUNTRY=India

# API Rate Limiting
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Monitoring
SENTRY_DSN=
